#!/bin/sh
# Local deployment only. The commit has already succeeded when this hook runs.
if [ "${HELLO_MYLOVE_SKIP_DEPLOY:-}" = "1" ]; then
  echo "[local-cd] Deployment skipped by HELLO_MYLOVE_SKIP_DEPLOY."
  exit 0
fi

repo_root=$(git rev-parse --show-toplevel) || exit 0
commit=$(git rev-parse HEAD) || exit 0
launcher="$repo_root/scripts/queue-local-deploy.ps1"
if [ ! -f "$launcher" ]; then
  echo "[local-cd] Deployment launcher is missing in this checkout."
  exit 0
fi

if command -v pwsh.exe >/dev/null 2>&1; then
  shell=pwsh.exe
else
  shell=powershell.exe
fi

"$shell" -NoProfile -ExecutionPolicy Bypass -File "$launcher" -RepositoryRoot "$repo_root" -Commit "$commit"
if [ $? -ne 0 ]; then
  echo "[local-cd] Could not queue deployment. Your commit is saved."
fi
exit 0
